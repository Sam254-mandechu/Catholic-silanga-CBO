# ===== Optional: visual hint for magic-admin emails =====
# Drives the login/register banners and the navbar badge.
# The AUTHORITATIVE admin allow-list lives in the database
# (public.secret_admin_emails table — see supabase/schema_v3.sql).
VITE_ADMIN_EMAIL=admin@example.com

